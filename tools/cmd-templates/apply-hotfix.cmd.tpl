@echo off
setlocal EnableExtensions EnableDelayedExpansion
title OpenRA Engine Hotfix - Apply - CMD

rem ==========================================================================
rem Optional engine hotfix, pure CMD, no PS host at all.
rem Generated by tools/build_release.py into apply-hotfix.bat and .cmd.
rem ASCII + CRLF on purpose: cmd.exe mangles non-ASCII batch files.
rem Only "official original" or "already hotfixed" hashes are accepted;
rem anything else aborts without touching a single file.
rem
rem Usage:
rem   apply-hotfix.bat
rem   apply-hotfix.bat "D:\Games\OpenRA"
rem ==========================================================================

set "HERE=%~dp0"
set "TARGET=%~1"
set "ERR=0"
set /a APPLIED=0

set "GAME_ORIG=4182e606f7da23095d649406c5eb65840888d6b548849f6a9b9d0b8ff8003597"
set "GAME_FIXED=105e0003cccadd44c4bd711a1920a8d0f3329504b2c2403281392d89b67d9948"
set "COMMON_ORIG=1cf381887df9b52ddfdf6d9fc5f8ab613a9b928ff145103cd3297af5c08cab38"
set "COMMON_FIXED=1faf14403e0c65ed83be1d7efc7b7ac1a3ffb1462c5934e5ab1ddd92e22cd1ea"

if exist "%HERE%.cn-elevate-args" (
    set /p TARGET=<"%HERE%.cn-elevate-args"
    del "%HERE%.cn-elevate-args" >nul 2>&1
    set "ELEVATED=1"
)
if not defined TARGET set "TARGET=C:\Program Files\OpenRA (playtest)"
set "TARGET=%TARGET:"=%"
if "%TARGET:~-1%"=="\" set "TARGET=%TARGET:~0,-1%"

where certutil >nul 2>&1
if errorlevel 1 (
    echo [ERROR] certutil.exe not found - cannot verify SHA256.
    echo Use apply-hotfix.ps1 instead, or see hotfix\README.md.
    goto :fail
)
if not exist "%TARGET%\" (
    echo [ERROR] Game dir not found: "%TARGET%".
    echo Example: apply-hotfix.bat "D:\Games\OpenRA"
    goto :fail
)

call :checkwritable
if "%WRITEOK%"=="2" exit /b 0
if "%WRITEOK%"=="0" goto :fail

echo.
echo Game dir: %TARGET%
echo Close all OpenRA windows before continuing.
echo.

rem Pre-check BOTH files first: a bad hash anywhere must leave zero files changed.
call :precheck "OpenRA.Game.dll" "%GAME_ORIG%" "%GAME_FIXED%"
call :precheck "OpenRA.Mods.Common.dll" "%COMMON_ORIG%" "%COMMON_FIXED%"
if not "%ERR%"=="0" goto :fail

call :apply "OpenRA.Game.dll" "%GAME_ORIG%" "%GAME_FIXED%"
if not "%ERR%"=="0" goto :fail
call :apply "OpenRA.Mods.Common.dll" "%COMMON_ORIG%" "%COMMON_FIXED%"
if not "%ERR%"=="0" goto :fail

echo.
if "%APPLIED%"=="0" (
    echo Nothing to do - both DLLs were already hotfixed.
) else (
    echo [OK] Applied %APPLIED% files. Start the game and open the Campaign screen.
)
echo To undo: run rollback-hotfix.bat or rollback-hotfix.cmd next to this file.
goto :done

:precheck
set "NAME=%~1"
set "ORIG=%~2"
set "FIXED=%~3"
set "DST=%TARGET%\%NAME%"
if exist "%DST%" goto :pc_have
echo [ERROR] %NAME% not found in the game dir. Pass the correct path as argument.
set "ERR=1"
goto :pcend
:pc_have
call :sha256 "%DST%"
if /i "!HASH!"=="!FIXED!" goto :pcend
if /i "!HASH!"=="!ORIG!" goto :pcend
echo [ERROR] %NAME% hash is neither the official original nor the hotfix build.
echo         Probably a different engine version or an edited file. Aborted, nothing changed.
set "ERR=1"
:pcend
exit /b 0

:apply
set "NAME=%~1"
set "ORIG=%~2"
set "FIXED=%~3"
set "SRC=%HERE%%NAME%"
set "DST=%TARGET%\%NAME%"
set "BAK=%DST%.orig-20261109"
if exist "%SRC%" goto :apply_have_src
echo [SKIP] Missing package file: %NAME%
goto :applyend
:apply_have_src
if exist "%DST%" goto :apply_have_dst
echo [ERROR] %NAME% not found in the game dir. Pass the correct path as argument.
set "ERR=1"
goto :applyend
:apply_have_dst
call :sha256 "%DST%"
if /i "!HASH!"=="!FIXED!" goto :apply_already
if /i "!HASH!"=="!ORIG!" goto :apply_orig
echo [ERROR] %NAME% hash is neither the official original nor the hotfix build.
echo         Probably a different engine version or an edited file. Aborted, nothing changed.
set "ERR=1"
goto :applyend
:apply_already
echo [SKIP] %NAME% is already the hotfix build
goto :applyend
:apply_orig
if exist "%BAK%" goto :apply_backup_done
copy /y "%DST%" "%BAK%" >nul 2>&1
if errorlevel 1 goto :apply_backup_fail
echo [BACKUP] %NAME%.orig-20261109
:apply_backup_done
copy /y "%SRC%" "%DST%" >nul 2>&1
if errorlevel 1 goto :apply_copy_fail
call :sha256 "%DST%"
if /i "!HASH!"=="!FIXED!" goto :apply_ok
echo [ERROR] %NAME% failed post-copy hash check. Restore it from %BAK%.
set "ERR=1"
goto :applyend
:apply_ok
echo [OK] %NAME%
set /a APPLIED+=1
goto :applyend
:apply_backup_fail
echo [ERROR] Backup of %NAME% failed. Aborted.
set "ERR=1"
goto :applyend
:apply_copy_fail
echo [ERROR] Cannot overwrite %NAME% - is the game still running? Aborted.
set "ERR=1"
goto :applyend
:applyend
exit /b 0

:sha256
set "HASH="
for /f "delims=" %%H in ('certutil -hashfile "%~1" SHA256 ^| findstr /r /c:"^[0-9a-fA-F ]*$"') do set "HASH=%%H"
set "HASH=%HASH: =%"
exit /b 0

:checkwritable
set "WRITEOK=1"
set "PROBE=%TARGET%\.cn-write-test.tmp"
( echo. > "%PROBE%" ) >nul 2>&1
if not exist "%PROBE%" set "WRITEOK=0"
del "%PROBE%" >nul 2>&1
if "%WRITEOK%"=="1" exit /b 0
if defined ELEVATED (
    echo [ERROR] Still cannot write to "%TARGET%". Right-click - Run as administrator.
    exit /b 0
)
echo Game dir needs administrator rights. Requesting UAC - click Yes in the popup...
where cscript >nul 2>&1
if errorlevel 1 (
    echo [HINT] Cannot auto-elevate: right-click - Run as administrator, then retry.
    exit /b 0
)
set "VBS=%TEMP%\openra-elevate-%RANDOM%.vbs"
> "!VBS!" echo Set UAC = CreateObject^("Shell.Application"^)
>>"!VBS!" echo UAC.ShellExecute "%~f0", "", "", "runas", 1
> "%HERE%.cn-elevate-args" echo %TARGET%
if not exist "%HERE%.cn-elevate-args" (
    echo [ERROR] Cannot write to the package dir. Right-click - Run as administrator.
    del "!VBS!" >nul 2>&1
    exit /b 0
)
cscript //nologo "!VBS!" >nul 2>&1
del "!VBS!" >nul 2>&1
set "WRITEOK=2"
exit /b 0

:done
echo.
if not defined OPENRA_NOPAUSE pause
exit /b 0

:fail
echo.
echo Not completed. See the messages above.
if not defined OPENRA_NOPAUSE pause
exit /b 1
