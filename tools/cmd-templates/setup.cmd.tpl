@echo off
setlocal EnableExtensions EnableDelayedExpansion
title OpenRA Chinese Patch - CMD installer

rem ==========================================================================
rem Pure CMD installer / restore / uninstall verifier.
rem No PS host is used at all. SHA256 is done by the built-in certutil.exe.
rem Generated by tools/build_release.py into setup.bat and setup.cmd.
rem ASCII + CRLF ON PURPOSE: cmd.exe mangles non-ASCII batch files under
rem chcp 65001, splitting echo/rem lines into bogus commands. Chinese steps
rem live in the packaged README and the install guide instead.
rem
rem Usage:
rem   setup.bat                              show menu
rem   setup.bat "D:\Games\OpenRA"            set game dir, then show menu
rem   setup.bat "D:\Games\OpenRA" /install   install directly
rem   setup.bat "D:\Games\OpenRA" /restore   restore English directly
rem   setup.bat "D:\Games\OpenRA" /verify    check uninstall, 0 clean / 1 left
rem   setup.bat "D:\Games\OpenRA" /install /force   skip the engine check
rem ==========================================================================

set "HERE=%~dp0"
set "LIST=%HERE%bin\files.sha256"
set "ENGINE=playtest-20261026"
set "TARGET=%~1"
set "ACTION=%~2"
set "ERR=0"

rem Elevated child window reads the game dir back from this temp file.
if exist "%HERE%.cn-elevate-args" (
    set /p TARGET=<"%HERE%.cn-elevate-args"
    del "%HERE%.cn-elevate-args" >nul 2>&1
    set "ELEVATED=1"
)

if not exist "%LIST%" (
    echo [ERROR] Missing deployment list: "!LIST!"
    echo Extract the WHOLE zip before running; do not copy a single file.
    goto :fail
)
where certutil >nul 2>&1
if errorlevel 1 (
    echo [ERROR] certutil.exe not found - cannot verify SHA256.
    echo Use setup.ps1 instead, or follow the manual steps in the README.
    goto :fail
)

rem ---- locate the game ----
if not defined TARGET (
    for /d %%D in ("C:\Program Files\OpenRA*") do if not defined TARGET set "TARGET=%%~fD"
)
if not defined TARGET (
    for /d %%D in ("%LOCALAPPDATA%\OpenRA*") do if not defined TARGET set "TARGET=%%~fD"
)
if not defined TARGET (
    set /p "TARGET=OpenRA not found. Enter full install path, e.g. D:\Games\OpenRA : "
)
set "TARGET=%TARGET:"=%"
if "%TARGET:~-1%"=="\" set "TARGET=%TARGET:~0,-1%"
if not exist "%TARGET%\mods\ra\mod.yaml" (
    echo [ERROR] No mods\ra\mod.yaml under "%TARGET%" - not an OpenRA install.
    echo Example: setup.bat "D:\Games\OpenRA"
    goto :fail
)

rem Engine check lives in :doinstall only. verify/restore must never prompt,
rem otherwise a non-interactive caller hangs forever on set /p.

rem ---- elevate only when the game dir is not writable ----
call :checkwritable
if "%WRITEOK%"=="2" exit /b 0
if "%WRITEOK%"=="0" goto :fail

echo.
echo Game dir : %TARGET%
echo.

if not defined ACTION (
    echo   1  Install Chinese patch  [backup - fonts - 208 texts - SHA256]
    echo   2  Restore English        [from the latest real pre-install backup]
    echo   3  Verify uninstall
    echo   0  Exit
    echo.
    set /p "ANS=Enter a number and press Enter: "
    if /i "!ANS!"=="1" set "ACTION=/install"
    if /i "!ANS!"=="2" set "ACTION=/restore"
    if /i "!ANS!"=="3" set "ACTION=/verify"
    if /i "!ANS!"=="0" goto :done
)
if /i "%ACTION%"=="/install" goto :doinstall
if /i "%ACTION%"=="/restore" goto :dorestore
if /i "%ACTION%"=="/verify" goto :doverify
echo [ERROR] Unknown action "%ACTION%". Use /install /restore /verify.
goto :fail

:doinstall
rem mod.yaml indents "Version:" with a TAB, so match the whole string instead of ^Version:
set "VER=unknown"
findstr /c:"Version: %ENGINE%" "%TARGET%\mods\ra\mod.yaml" >nul 2>&1
if not errorlevel 1 set "VER=%ENGINE%"
if /i not "%VER%"=="%ENGINE%" (
    echo [WARN] Could not confirm engine %ENGINE% in mods\ra\mod.yaml.
    echo Installing on a different engine shows raw label-xxx keys.
    if /i not "%~3"=="/force" (
        echo [ERROR] Aborted. Add /force as a third argument to override.
        goto :fail
    )
)
echo Engine   : %VER%

call :nextbackup
if not defined STAMP goto :fail
set "BACKUP=%TARGET%\_zhcn-backup\%STAMP%"
echo [1/3] Backing up mods to %BACKUP% ...
if not exist "%BACKUP%\" md "%BACKUP%" 2>nul
if not exist "%BACKUP%\" (
    echo [ERROR] Cannot create backup dir. Check write permissions.
    goto :fail
)
robocopy "%TARGET%\mods" "%BACKUP%\mods" /E /NFL /NDL /NJH /NJS /NP >nul 2>&1
if errorlevel 8 (
    echo [ERROR] Backup failed, robocopy code !errorlevel!. No game file changed.
    goto :fail
)

rem List columns: SHA256 / source path in the package / relative game path.
rem Fonts come first: deploying texts before fonts makes the engine fail to start.
echo [2/3] Deploying fonts and 208 texts, verifying SHA256 per file ...
set /a TOTAL=0
set /a BAD=0
for /f "usebackq tokens=1,2,3" %%A in ("%LIST%") do (
    set "WANT=%%A"
    set "SRC=%%B"
    set "DST=%%C"
    set "SRCPATH=%HERE%!SRC:/=\!"
    set "DSTPATH=%TARGET%\!DST:/=\!"
    for %%F in ("!DSTPATH!") do set "DSTDIR=%%~dpF"
    if not exist "!DSTDIR!" md "!DSTDIR!" 2>nul
    if not exist "!SRCPATH!" (
        echo   [MISSING] !SRC!
        set /a BAD+=1
    ) else (
        copy /y "!SRCPATH!" "!DSTPATH!" >nul 2>&1
        if errorlevel 1 (
            echo   [FAILED] cannot write !DST!
            set /a BAD+=1
        ) else (
            call :sha256 "!DSTPATH!"
            if /i not "!HASH!"=="!WANT!" (
                echo   [HASH MISMATCH] !DST!
                set /a BAD+=1
            )
        )
    )
    set /a TOTAL+=1
)
echo [3/3] Checked !TOTAL! files, !BAD! failed.
if not "!BAD!"=="0" (
    echo [ERROR] Verification failed. Use menu 2 to restore from the backup.
    goto :fail
)
echo.
echo [OK] Chinese patch installed. Start the game.
echo Backup: %BACKUP%
goto :done

:dorestore
rem Skip "installed twice" backups: their chrome.ftl is already Chinese.
set "ZHCHROME="
for /f "usebackq tokens=1,2,3" %%A in ("%LIST%") do if /i "%%C"=="mods/common/fluent/chrome.ftl" set "ZHCHROME=%%A"
set "BACKUP="
for /f "delims=" %%B in ('dir /b /ad /o-n "%TARGET%\_zhcn-backup" 2^>nul ^| findstr /r "^[0-9][0-9][0-9][0-9]$"') do (
    if not defined BACKUP (
        set "CAND=%TARGET%\_zhcn-backup\%%B"
        if exist "!CAND!\mods\common\fluent\chrome.ftl" (
            call :sha256 "!CAND!\mods\common\fluent\chrome.ftl"
            if /i not "!HASH!"=="!ZHCHROME!" set "BACKUP=!CAND!"
        )
    )
)
if not defined BACKUP (
    echo [ERROR] No usable pre-install backup under _zhcn-backup.
    goto :fail
)
echo Using backup: !BACKUP!
set /a TOTAL=0
set /a BAD=0
for /f "usebackq tokens=1,2,3" %%A in ("%LIST%") do (
    set "DST=%%C"
    set "DSTPATH=%TARGET%\!DST:/=\!"
    set "BAKPATH=!BACKUP!\!DST:/=\!"
    if exist "!BAKPATH!" (
        for %%F in ("!DSTPATH!") do if not exist "%%~dpF" md "%%~dpF" 2>nul
        copy /y "!BAKPATH!" "!DSTPATH!" >nul 2>&1
        if errorlevel 1 (
            echo   [FAILED] cannot restore !DST!
            set /a BAD+=1
        )
    ) else (
        del "!DSTPATH!" >nul 2>&1
    )
    set /a TOTAL+=1
)
echo Processed !TOTAL! entries, !BAD! failed.
if not "!BAD!"=="0" goto :fail
echo.
echo [OK] Restored to English; patch-only texts and fonts removed.
goto :done

:doverify
set /a LEFT=0
set /a CHECKED=0
for /f "usebackq tokens=1,2,3" %%A in ("%LIST%") do (
    set "WANT=%%A"
    set "DST=%%C"
    set "DSTPATH=%TARGET%\!DST:/=\!"
    if exist "!DSTPATH!" (
        call :sha256 "!DSTPATH!"
        if /i "!HASH!"=="!WANT!" set /a LEFT+=1
    )
    set /a CHECKED+=1
)
echo Checked !CHECKED! entries, !LEFT! still Chinese.
if not "!LEFT!"=="0" (
    echo Result: NOT fully uninstalled, those files are still translated.
    set "ERR=1"
) else (
    echo Result: clean, English originals.
)
echo.
if not defined OPENRA_NOPAUSE pause
exit /b %ERR%

:sha256
set "HASH="
for /f "delims=" %%H in ('certutil -hashfile "%~1" SHA256 ^| findstr /r /c:"^[0-9a-fA-F ]*$"') do set "HASH=%%H"
set "HASH=%HASH: =%"
exit /b 0

:checkwritable
set "WRITEOK=1"
set "PROBE=%TARGET%\.cn-write-test.tmp"
( echo. > "%PROBE%" ) >nul 2>&1
if not exist "%PROBE%" set "WRITEOK=0"
del "%PROBE%" >nul 2>&1
if "%WRITEOK%"=="1" exit /b 0
if defined ELEVATED (
    echo [ERROR] Still cannot write to "%TARGET%". Right-click - Run as administrator.
    exit /b 0
)
echo Game dir needs administrator rights. Requesting UAC - click Yes in the popup...
where cscript >nul 2>&1
if errorlevel 1 (
    echo [HINT] Cannot auto-elevate: right-click - Run as administrator, then retry.
    exit /b 0
)
set "VBS=%TEMP%\openra-elevate-%RANDOM%.vbs"
> "!VBS!" echo Set UAC = CreateObject^("Shell.Application"^)
>>"!VBS!" echo UAC.ShellExecute "%~f0", "", "", "runas", 1
> "%HERE%.cn-elevate-args" echo %TARGET%
if not exist "%HERE%.cn-elevate-args" (
    echo [ERROR] Cannot write to the package dir. Right-click - Run as administrator.
    del "!VBS!" >nul 2>&1
    exit /b 0
)
cscript //nologo "!VBS!" >nul 2>&1
del "!VBS!" >nul 2>&1
set "WRITEOK=2"
exit /b 0

:nextbackup
rem wmic was removed from recent Windows builds. Use a 4-digit increasing id
rem instead: it sorts correctly with dir /o-n and never depends on date locale.
set "STAMP=0001"
set "LAST="
for /f "delims=" %%B in ('dir /b /ad /o-n "%TARGET%\_zhcn-backup" 2^>nul ^| findstr /r "^[0-9][0-9][0-9][0-9]$"') do (
    if not defined LAST set "LAST=%%B"
)
if defined LAST (
    set /a NUM=1!LAST! - 10000 + 1
    if !NUM! GTR 9999 (
        echo [ERROR] Too many backups, clean up _zhcn-backup first.
        set "STAMP="
    ) else (
        set "RAW=000!NUM!"
        set "STAMP=!RAW:~-4!"
    )
)
exit /b 0

:done
echo.
if not defined OPENRA_NOPAUSE pause
exit /b 0

:fail
echo.
echo Not completed. See the messages above.
if not defined OPENRA_NOPAUSE pause
exit /b 1
