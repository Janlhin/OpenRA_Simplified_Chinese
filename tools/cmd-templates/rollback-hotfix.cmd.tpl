@echo off
setlocal EnableExtensions EnableDelayedExpansion
title OpenRA Engine Hotfix - Rollback - CMD

rem ==========================================================================
rem Optional engine hotfix rollback, pure CMD, no PS host at all.
rem Generated by tools/build_release.py into rollback-hotfix.bat and .cmd.
rem ASCII + CRLF on purpose: cmd.exe mangles non-ASCII batch files.
rem Restores from *.orig-20261109 and checks the result against the official hash.
rem
rem Usage:
rem   rollback-hotfix.bat
rem   rollback-hotfix.bat "D:\Games\OpenRA"
rem ==========================================================================

set "HERE=%~dp0"
set "TARGET=%~1"
set "ERR=0"
set /a RESTORED=0

set "GAME_ORIG=4182e606f7da23095d649406c5eb65840888d6b548849f6a9b9d0b8ff8003597"
set "COMMON_ORIG=1cf381887df9b52ddfdf6d9fc5f8ab613a9b928ff145103cd3297af5c08cab38"

if exist "%HERE%.cn-elevate-args" (
    set /p TARGET=<"%HERE%.cn-elevate-args"
    del "%HERE%.cn-elevate-args" >nul 2>&1
    set "ELEVATED=1"
)
if not defined TARGET set "TARGET=C:\Program Files\OpenRA (playtest)"
set "TARGET=%TARGET:"=%"
if "%TARGET:~-1%"=="\" set "TARGET=%TARGET:~0,-1%"

where certutil >nul 2>&1
if errorlevel 1 (
    echo [ERROR] certutil.exe not found - cannot verify SHA256.
    echo Use rollback-hotfix.ps1 instead, or see hotfix\README.md.
    goto :fail
)
if not exist "%TARGET%\" (
    echo [ERROR] Game dir not found: "%TARGET%".
    echo Example: rollback-hotfix.bat "D:\Games\OpenRA"
    goto :fail
)

call :checkwritable
if "%WRITEOK%"=="2" exit /b 0
if "%WRITEOK%"=="0" goto :fail

echo.
echo Game dir: %TARGET%
echo Close all OpenRA windows before continuing.
echo.

call :restore "OpenRA.Game.dll" "%GAME_ORIG%"
call :restore "OpenRA.Mods.Common.dll" "%COMMON_ORIG%"
if not "%ERR%"=="0" goto :fail

echo.
if "%RESTORED%"=="0" (
    echo No backups to restore - the hotfix was probably never applied.
) else (
    echo [OK] Restored %RESTORED% files to the official originals.
)
echo Once upstream fixes the bug, just delete the hotfix dir - no rollback needed.
goto :done

:restore
set "NAME=%~1"
set "ORIG=%~2"
set "DST=%TARGET%\%NAME%"
set "BAK=%DST%.orig-20261109"
if exist "%BAK%" goto :restore_have_bak
echo [SKIP] No backup: %NAME%.orig-20261109
goto :restoreend
:restore_have_bak
if exist "%DST%" goto :restore_have_dst
echo [ERROR] %NAME% not found in the game dir. Pass the correct path as argument.
set "ERR=1"
goto :restoreend
:restore_have_dst
copy /y "%BAK%" "%DST%" >nul 2>&1
if errorlevel 1 goto :restore_copy_fail
call :sha256 "%DST%"
if /i "!HASH!"=="!ORIG!" goto :restore_ok
echo [ERROR] %NAME% does not match the official hash after restore. Check manually.
set "ERR=1"
goto :restoreend
:restore_ok
echo [OK] %NAME%
set /a RESTORED+=1
goto :restoreend
:restore_copy_fail
echo [ERROR] Cannot restore %NAME% - is the game still running? Aborted.
set "ERR=1"
goto :restoreend
:restoreend
exit /b 0

:sha256
set "HASH="
for /f "delims=" %%H in ('certutil -hashfile "%~1" SHA256 ^| findstr /r /c:"^[0-9a-fA-F ]*$"') do set "HASH=%%H"
set "HASH=%HASH: =%"
exit /b 0

:checkwritable
set "WRITEOK=1"
set "PROBE=%TARGET%\.cn-write-test.tmp"
( echo. > "%PROBE%" ) >nul 2>&1
if not exist "%PROBE%" set "WRITEOK=0"
del "%PROBE%" >nul 2>&1
if "%WRITEOK%"=="1" exit /b 0
if defined ELEVATED (
    echo [ERROR] Still cannot write to "%TARGET%". Right-click - Run as administrator.
    exit /b 0
)
echo Game dir needs administrator rights. Requesting UAC - click Yes in the popup...
where cscript >nul 2>&1
if errorlevel 1 (
    echo [HINT] Cannot auto-elevate: right-click - Run as administrator, then retry.
    exit /b 0
)
set "VBS=%TEMP%\openra-elevate-%RANDOM%.vbs"
> "!VBS!" echo Set UAC = CreateObject^("Shell.Application"^)
>>"!VBS!" echo UAC.ShellExecute "%~f0", "", "", "runas", 1
> "%HERE%.cn-elevate-args" echo %TARGET%
if not exist "%HERE%.cn-elevate-args" (
    echo [ERROR] Cannot write to the package dir. Right-click - Run as administrator.
    del "!VBS!" >nul 2>&1
    exit /b 0
)
cscript //nologo "!VBS!" >nul 2>&1
del "!VBS!" >nul 2>&1
set "WRITEOK=2"
exit /b 0

:done
echo.
if not defined OPENRA_NOPAUSE pause
exit /b 0

:fail
echo.
echo Not completed. See the messages above.
if not defined OPENRA_NOPAUSE pause
exit /b 1
